# Maintainer: ledati16 <ledati16@users.noreply.github.com>
pkgname=pwsw-git
_pkgname=pwsw
pkgver=r0
pkgrel=1
pkgdesc="PipeWire Switcher - Automatically switch audio sinks based on active windows"
arch=('x86_64')
url="https://github.com/ledati16/pwsw"
license=('MIT')
depends=('gcc-libs' 'glibc' 'pipewire')
# rustup honours the repo's rust-toolchain.toml (pinned Rust version)
makedepends=('git' 'rustup')
optdepends=('notification-daemon: desktop notifications (mako, dunst, swaync, ...)'
            'wireplumber: session manager pwsw expects for default-sink handling')
provides=('pwsw')
conflicts=('pwsw')
source=("${_pkgname}::git+${url}.git")
sha256sums=('SKIP')

pkgver() {
    cd "$_pkgname"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
    cd "$_pkgname"
    # No RUSTUP_TOOLCHAIN override: the toolchain comes from rust-toolchain.toml
    cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
    cd "$_pkgname"
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

check() {
    cd "$_pkgname"
    export CARGO_TARGET_DIR=target
    # Keep the toolchain reachable, then run the suite with HOME/XDG in a throwaway
    # sandbox and without the session's Wayland/D-Bus, so tests can never see the
    # packager's real pwsw config, daemon or audio session.
    export RUSTUP_HOME="${RUSTUP_HOME:-$HOME/.rustup}" CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"
    local _sandbox="$srcdir/check-home"
    rm -rf "$_sandbox"
    mkdir -p "$_sandbox"/{home,config,data,state,runtime}
    chmod 700 "$_sandbox/runtime"
    env -u WAYLAND_DISPLAY -u DBUS_SESSION_BUS_ADDRESS -u PWSW_CONFIG -u PIPEWIRE_REMOTE \
        HOME="$_sandbox/home" \
        XDG_CONFIG_HOME="$_sandbox/config" \
        XDG_DATA_HOME="$_sandbox/data" \
        XDG_STATE_HOME="$_sandbox/state" \
        XDG_RUNTIME_DIR="$_sandbox/runtime" \
        cargo test --frozen
}

package() {
    cd "$_pkgname"
    install -Dm755 target/release/pwsw "$pkgdir/usr/bin/pwsw"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 contrib/pwsw.desktop "$pkgdir/usr/share/applications/pwsw.desktop"
    install -Dm644 contrib/pwsw.service "$pkgdir/usr/lib/systemd/user/pwsw.service"
    for size in 16 24 32 48 64 128 256 512; do
        install -Dm644 "contrib/icons/pwsw-${size}.png" \
            "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/pwsw.png"
    done
    install -Dm644 contrib/icons/pwsw.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/pwsw.svg"

    # Man pages are generated by build.rs into the build script's OUT_DIR; take the
    # newest one so a stale build dir can never win, and fail loudly if missing.
    local _mandir
    _mandir=$(find target/release/build -path '*/out/man/pwsw.1' -printf '%T@ %h\n' \
        | sort -n | tail -n 1 | cut -d' ' -f2-)
    if [[ -z "$_mandir" ]]; then
        echo "error: generated man pages not found under target/release/build" >&2
        return 1
    fi
    install -Dm644 "$_mandir/pwsw.1" "$pkgdir/usr/share/man/man1/pwsw.1"
    install -Dm644 "$_mandir/pwsw.5" "$pkgdir/usr/share/man/man5/pwsw.5"
}
